# ORUM · Plantilla de variables de entorno
#
# Copia este archivo a `.env.local` y rellena los valores reales:
#   cp .env.example .env.local
#
# `.env.local` NUNCA se sube al repositorio (está en .gitignore).
# Los valores salen del panel de Supabase: Project Settings -> API.

# URL del proyecto de Supabase. Ej.: https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave publicable (formato nuevo: empieza por `sb_publishable_`).
# Se expone al navegador a propósito: solo permite lo que autoricen las
# políticas de la base de datos.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio (formato nuevo: empieza por `sb_secret_`).
#
# ATENCIÓN: salta cualquier política de seguridad de la base de datos.
# Solo se usa en el servidor, aislada en `src/lib/supabase/admin.ts`.
# No lleva el prefijo NEXT_PUBLIC_ y no debe llevarlo nunca: eso la
# publicaría en el bundle del navegador.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Correo transaccional (SMTP de Gmail / Google Workspace) — OPCIONAL
#
# Se usa para las invitaciones de alta y la recuperación de contraseña. El
# envío es "best-effort": si estas variables faltan o el servicio falla, la
# operación se completa igual y el error solo queda en el log del servidor.
# Por eso conviene revisarlas: una ausencia NO da error visible.
# ---------------------------------------------------------------------------

# Cuenta de Workspace que AUTENTICA el envío (correo real, p. ej. el del admin).
GMAIL_SMTP_USER=

# Contraseña de aplicación de esa cuenta (16 caracteres; requiere verificación
# en 2 pasos). NO es la contraseña normal de la cuenta. Nunca se sube al repo.
GMAIL_SMTP_APP_PASSWORD=

# Remitente que VEN los destinatarios. Puede ser un alias de la cuenta anterior
# (p. ej. no-reply@tudominio.com); debe estar añadido en Gmail como "Enviar como".
GMAIL_FROM_EMAIL=

# Dominio real del sitio, sin barra final. Ej.: https://orum.example.com
# Base de los enlaces de los correos. En local puede omitirse (usa
# http://localhost:3000); en PRODUCCIÓN es OBLIGATORIA: sin ella el enlace de
# invitación/recuperación apunta a localhost y no lleva a ninguna parte.
NEXT_PUBLIC_SITE_URL=

# Destinatario de las solicitudes de comercios que quieren aliarse, enviadas
# desde el formulario público de `/aliados`. Si se omite, las recibe la propia
# dirección de GMAIL_FROM_EMAIL.
#
# A DIFERENCIA del correo de bienvenida, este envío NO es "best-effort": si
# falla, el visitante ve el error y una salida por WhatsApp. Una solicitud
# perdida en silencio es un comercio aliado perdido, y nadie se entera nunca.
SOLICITUDES_EMAIL=

# ---------------------------------------------------------------------------
# Cloudflare Turnstile — protección de los formularios de acceso
#
# Widget anti-bot en los tres logins (admin, miembros, comercios). La server
# action valida el token antes de tocar Supabase (fail-closed).
#
# En LOCAL pueden omitirse: se usan las llaves de prueba oficiales de
# Cloudflare, que siempre pasan. En PRODUCCIÓN son OBLIGATORIAS — sin ellas
# cualquier caída de red bloquea los accesos.
#
# Se sacan del panel de Cloudflare -> Turnstile -> añadir sitio (modo Managed).
# ---------------------------------------------------------------------------

# Clave pública del widget. Se expone al navegador a propósito.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Clave secreta para validar el token en el servidor. Nunca con prefijo
# NEXT_PUBLIC_.
TURNSTILE_SECRET_KEY=

# Mercado Pago (suscripciones). Credenciales de PRUEBA y de PRODUCCIÓN por
# separado; nunca con prefijo NEXT_PUBLIC_ ni en el repositorio.
# Access Token de la aplicación (panel de Mercado Pago → Credenciales).
MP_ACCESS_TOKEN=
# Clave secreta de firma de webhooks (panel de Mercado Pago → Webhooks).
MP_WEBHOOK_SECRET=

# Secreto de la limpieza diaria de cuentas sin pago (/api/cron/limpiar-pendientes).
# Vercel Cron lo envía solo como `Authorization: Bearer …`. Sin él, la ruta no hace nada.
# Genera uno largo y aleatorio. Nunca con prefijo NEXT_PUBLIC_.
CRON_SECRET=

# Solo en la vista previa / pruebas: correo de un usuario de prueba de Mercado
# Pago que hace de pagador (con credenciales de prueba el pagador tiene que ser
# un usuario de prueba). NO definir en producción.
MP_PAGADOR_PRUEBA=
